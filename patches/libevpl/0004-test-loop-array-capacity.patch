+
+# Arms more than the initial 256 timers and deferrals on one evpl: the loop
+# arrays must grow past their initial capacity rather than overflow.  Creates
+# and destroys an evpl without touching the network, so it needs neither a
+# namespace nor the shared port lock.
+unit_test(core loop_array_capacity loop_array_capacity.c)
 unit_test_all_mechs(core destroy_pending destroy_pending.c)
 unit_test_all_mechs(core listener_lifetime listener_lifetime.c)
 
