diff --git a/src/core/poll.c b/src/core/poll.c
index 7df8da5..0e40f39 100644
--- a/src/core/poll.c
+++ b/src/core/poll.c
@@ -39,6 +39,13 @@ evpl_add_poll(
     }
 
     if (!poll) {
+        /* A poll slot is the durable handle every registered poller holds, so
+         * the array must never move (see the file header): refuse once the
+         * fixed capacity is reached rather than relocate live slots, and let
+         * the caller fail its init on the NULL return. */
+        if (evpl->num_poll == evpl->max_poll) {
+            return NULL;
+        }
         poll = &evpl->poll[evpl->num_poll++];
     }
 
