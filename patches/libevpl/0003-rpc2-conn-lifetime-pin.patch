+/*
+ * Connection-lifetime teardown and pin (Defect 2 as described in the task).
+ *
+ * evpl_rpc2_conn_maybe_free() performs the one-time teardown the disconnect
+ * handler used to do inline (drop any reassembly iovecs, tear down RPCSEC_GSS
+ * contexts, free the conn object).  It runs either straight from disconnect
+ * when no server request is in flight, or from the last evpl_rpc2_conn_release
+ * once the in-flight requests have drained -- exactly once either way.
+ */
+static void
+evpl_rpc2_conn_maybe_free(
+    struct evpl           *evpl,
+    struct evpl_rpc2_conn *conn)
+{
+    evpl_rpc2_reasm_reset(evpl, conn);
+    evpl_rpc2_gss_conn_cleanup(conn->thread, conn);
+    evpl_free(conn);
+} /* evpl_rpc2_conn_maybe_free */
+
+SYMBOL_EXPORT void
+evpl_rpc2_conn_ref(struct evpl_rpc2_conn *conn)
+{
+    conn->server_refs++;
+} /* evpl_rpc2_conn_ref */
+
+SYMBOL_EXPORT void
+evpl_rpc2_conn_release(
+    struct evpl           *evpl,
+    struct evpl_rpc2_conn *conn)
+{
+    evpl_rpc2_abort_if(conn->server_refs == 0,
+                       "evpl_rpc2_conn_release underflow");
+    conn->server_refs--;
+
+    if (conn->closed && conn->server_refs == 0) {
+        evpl_rpc2_conn_maybe_free(evpl, conn);
+    }
+} /* evpl_rpc2_conn_release */
+
+SYMBOL_EXPORT int
+evpl_rpc2_conn_is_closed(struct evpl_rpc2_conn *conn)
+{
+    return conn->closed;
+} /* evpl_rpc2_conn_is_closed */
+
