diff --git a/src/rpc2/tests/conn_lifetime.c b/src/rpc2/tests/conn_lifetime.c
new file mode 100644
index 0000000..79bd192
--- /dev/null
+++ b/src/rpc2/tests/conn_lifetime.c
@@ -0,0 +1,229 @@
+// SPDX-FileCopyrightText: 2026 Ben Jarvis
+//
+// SPDX-License-Identifier: LGPL-2.1-only
+
+/*
+ * Connection-lifetime test (Defect 2 as described in the task).
+ *
+ * A server handler defers its reply (as a real server does across an async VFS
+ * operation) instead of answering inline, so a server request is still in
+ * flight when the client connection drops.  The test then disconnects the
+ * client, waits for the server to observe the disconnect, and only afterwards
+ * completes the deferred reply.
+ *
+ * The reply must be dropped safely: the server connection the request arrived
+ * on is kept alive by the in-flight request's reference until the reply is
+ * produced, and because the connection is closed the reply is discarded rather
+ * than written to a bind that may already have been recycled.  Without the
+ * connection-lifetime pin the deferred reply dereferences a freed connection --
+ * a use-after-free the Debug (AddressSanitizer) build catches.
+ */
+
+#include "core/os.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#ifdef _WIN32
+#include "tests/test_options.h"
+#else  /* ifdef _WIN32 */
+#include <getopt.h>
+#endif /* ifdef _WIN32 */
+
+#include "evpl/evpl.h"
+#include "evpl/evpl_rpc2.h"
+
+#include "core/test_log.h"
+#include "test_common.h"
+
+#include "conn_lifetime_xdr.h"
+
+static enum evpl_protocol_id proto = EVPL_STREAM_SOCKET_TCP;
+static int                   port  = 8000;
+
+struct test_state {
+    struct CONNLIFE_V1        *prog;
+    struct evpl_rpc2_encoding *stashed_encoding;
+    struct evpl_rpc2_conn     *client_conn;
+    int                        server_received;
+    int                        server_disconnected;
+};
+
+/* Keep the single-threaded event loop live so evpl_continue() does not block
+ * indefinitely once the exchange goes idle between phases. */
+static void
+keepalive_cb(
+    struct evpl       *evpl,
+    struct evpl_timer *timer)
+{
+} /* keepalive_cb */
+
+/* rpc2 connection notifications: both the client and the accepted server
+ * connection report through here.  Flag the server connection's disconnect --
+ * the one that is NOT the client connection -- so the test can wait for the
+ * server to have observed the drop before completing the deferred reply. */
+static void
+conn_notify(
+    struct evpl_rpc2_thread *thread,
+    struct evpl_rpc2_conn   *conn,
+    struct evpl_rpc2_notify *notify,
+    void                    *private_data)
+{
+    struct test_state *state = private_data;
+
+    if (notify->notify_type == EVPL_RPC2_NOTIFY_DISCONNECTED &&
+        conn != state->client_conn) {
+        state->server_disconnected = 1;
+    }
+} /* conn_notify */
+
+/* Server-side: stash the reply handle and return WITHOUT replying, leaving the
+ * request in flight on its connection. */
+void
+server_recv_ping(
+    struct evpl               *evpl,
+    struct evpl_rpc2_conn     *conn,
+    struct evpl_rpc2_cred     *cred,
+    struct CLMsg              *call,
+    struct evpl_rpc2_encoding *encoding,
+    void                      *private_data)
+{
+    struct test_state *state = private_data;
+
+    evpl_test_info("Server received PING id=%u; deferring reply", call->id);
+
+    state->stashed_encoding = encoding;
+    state->server_received  = 1;
+} /* server_recv_ping */
+
+/* Client-side: a reply must never arrive -- the connection is torn down before
+ * one is produced, and the deferred reply is dropped. */
+void
+client_recv_reply_ping(
+    struct evpl                 *evpl,
+    const struct evpl_rpc2_verf *verf,
+    struct CLMsg                *reply,
+    int                          status,
+    void                        *callback_private_data)
+{
+    evpl_test_info("Client reply callback fired (status=%d)", status);
+} /* client_recv_reply_ping */
+
+static void
+usage(const char *prog_name)
+{
+    fprintf(stderr, "Usage: %s [-r protocol] [-p port]\n", prog_name);
+    exit(1);
+} /* usage */
+
+int
+main(
+    int   argc,
+    char *argv[])
+{
+    struct evpl              *evpl;
+    struct evpl_rpc2_server  *server;
+    struct evpl_rpc2_conn    *conn;
+    struct evpl_rpc2_thread  *thread;
+    struct evpl_endpoint     *endpoint;
+    struct evpl_timer         keepalive;
+    struct CONNLIFE_V1        prog;
+    struct CLMsg              request, reply;
+    struct evpl_rpc2_program *programs[1];
+    struct test_state         state = { 0 };
+    int                       opt, rc, i;
+
+    test_evpl_config();
+
+    while ((opt = getopt(argc, argv, "r:p:")) != -1) {
+        switch (opt) {
+            case 'r':
+                rc = evpl_protocol_lookup(&proto, optarg);
+                if (rc) {
+                    fprintf(stderr, "Invalid protocol '%s'\n", optarg);
+                    return 1;
+                }
+                break;
+            case 'p':
+                port = atoi(optarg);
+                break;
+            default:
+                usage(argv[0]);
+        } /* switch */
+    }
+
+    evpl = evpl_create(NULL);
+
+    CONNLIFE_V1_init(&prog);
+    prog.recv_call_PING = server_recv_ping;
+    programs[0]         = &prog.rpc2;
+    state.prog          = &prog;
+
+    server   = evpl_rpc2_server_init(programs, 1);
+    endpoint = evpl_endpoint_create(test_address(proto, "127.0.0.1", argv[0]), port);
+    evpl_rpc2_server_start(server, proto, endpoint);
+
+    thread = evpl_rpc2_thread_init(evpl, programs, 1, conn_notify, &state);
+    evpl_rpc2_server_attach(thread, server, &state);
+
+    evpl_add_timer(evpl, &keepalive, keepalive_cb, 1000 /* us periodic */);
+
+    conn = evpl_rpc2_client_connect(thread, proto, endpoint, NULL, 0, NULL);
+    if (!conn) {
+        evpl_test_error("Failed to create RPC2 client");
+        evpl_destroy(evpl);
+        return 1;
+    }
+    state.client_conn = conn;
+
+    request.id = 7;
+    xdr_set_str_static(&request, text, "ping", strlen("ping"));
+
+    evpl_test_info("Client sending PING");
+    prog.send_call_PING(&prog.rpc2, evpl, conn, NULL, &request, 0, 0, NULL, 0, 0,
+                        client_recv_reply_ping, &state);
+
+    /* Let the server receive the call and stash the deferred reply handle. */
+    for (i = 0; i < 5000 && !state.server_received; i++) {
+        evpl_continue(evpl);
+    }
+    evpl_test_abort_if(!state.server_received, "server never received the call");
+
+    /* Drop the client connection with the server reply still outstanding. */
+    evpl_test_info("Disconnecting client with a server reply still in flight");
+    evpl_rpc2_client_disconnect(thread, conn);
+
+    /* Wait for the server to observe the disconnect: the server-side connection
+     * is latched closed (kept alive only by the in-flight request's pin) and
+     * its bind is torn down and may be recycled. */
+    for (i = 0; i < 5000 && !state.server_disconnected; i++) {
+        evpl_continue(evpl);
+    }
+    evpl_test_abort_if(!state.server_disconnected,
+                       "server never observed the disconnect");
+
+    /* Now complete the deferred reply.  With the connection-lifetime pin this is
+     * dropped safely (the connection is closed); without it this dereferences a
+     * freed connection and, under ASan, aborts here. */
+    reply.id = 100;
+    xdr_set_str_static(&reply, text, "pong", strlen("pong"));
+    evpl_test_info("Completing the deferred reply on the dead connection");
+    rc = prog.send_reply_PING(evpl, NULL, &reply, state.stashed_encoding);
+    evpl_test_abort_if(rc, "send_reply_PING returned an error");
+
+    /* Pump a little so the drop path (request free, pin release, deferred conn
+     * free) runs to completion and ASan can flag any late use. */
+    for (i = 0; i < 200; i++) {
+        evpl_continue(evpl);
+    }
+
+    evpl_remove_timer(evpl, &keepalive);
+    evpl_rpc2_server_stop(server);
+    evpl_rpc2_server_detach(thread, server);
+    evpl_rpc2_thread_destroy(thread);
+    evpl_rpc2_server_destroy(server);
+    evpl_destroy(evpl);
+
+    printf("Test PASSED\n");
+    return 0;
+} /* main */
