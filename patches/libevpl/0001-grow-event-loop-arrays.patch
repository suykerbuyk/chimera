+/* Append an event to the active-events array, growing it first if the fixed
+ * base capacity is reached.  Factors the single write every interest/mark path
+ * below performs so the capacity check lives in exactly one place. */
+static inline void
+evpl_active_event_append(
+    struct evpl       *evpl,
+    struct evpl_event *event)
+{
+    if (evpl->num_active_events == evpl->max_active_events) {
+        evpl->active_events = evpl_loop_array_grow(
+            evpl->active_events, &evpl->max_active_events,
+            sizeof(*evpl->active_events));
+    }
+
+    evpl->active_events[evpl->num_active_events++] = event;
+} /* evpl_active_event_append */
 
 
