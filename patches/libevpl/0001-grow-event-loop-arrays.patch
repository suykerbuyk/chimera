diff --git a/src/core/loop_array.h b/src/core/loop_array.h
new file mode 100644
index 0000000..e76eff1
--- /dev/null
+++ b/src/core/loop_array.h
@@ -0,0 +1,50 @@
+// SPDX-FileCopyrightText: 2026 Ben Jarvis
+//
+// SPDX-License-Identifier: LGPL-2.1-only
+
+#pragma once
+
+#include <stddef.h>
+#include <limits.h>
+#include <string.h>
+
+#include "core/evpl.h"
+#include "core/logging.h"
+
+/*
+ * Geometric (doubling) growth for the event loop's fixed-base pointer arrays
+ * (timers, active_deferrals, active_events).  Each is addressed only through
+ * its evpl->* field by index -- there is no cached base pointer and no stored
+ * back-index -- so a realloc that moves the buffer is observed on the next
+ * index.  Doubling keeps inserts amortized O(1) and makes the matching max_*
+ * field the live capacity rather than a dead initial value.
+ *
+ * The doubled element count and its byte size are computed in size_t so the
+ * arithmetic cannot wrap before it is narrowed to evpl_realloc's unsigned int
+ * size argument; an overflow aborts rather than wrapping.  The work that drives
+ * these arrays is bounded per connection, so the overflow path is unreachable
+ * in practice and the guard is purely defensive.
+ */
+static inline void *
+evpl_loop_array_grow(
+    void   *array,
+    int    *capacity,
+    size_t  elem_size)
+{
+    int    old_cap = *capacity;
+    size_t new_cap = (size_t) old_cap * 2;
+    size_t bytes   = new_cap * elem_size;
+
+    evpl_core_abort_if(old_cap <= 0 || new_cap > (size_t) INT_MAX ||
+                       bytes / elem_size != new_cap || bytes > (size_t) UINT_MAX,
+                       "event loop array growth capacity overflow");
+
+    array = evpl_realloc(array, (unsigned int) bytes);
+
+    memset((char *) array + (size_t) old_cap * elem_size, 0,
+           (new_cap - (size_t) old_cap) * elem_size);
+
+    *capacity = (int) new_cap;
+
+    return array;
+} /* evpl_loop_array_grow */
