#
# series.sha -- pins and sentinels for the libevpl event-loop patch series.
#
# Grammar (whitespace-separated, '#' comments, blank lines ignored):
#   repo-root <path>            path of the patched repo relative to the libevpl
#                               overlay root; git apply uses it as --directory.
#                               "." here: these patches touch libevpl's own tree.
#   base <sha>                  the upstream libevpl SHA this series was authored
#                               against (the pinned ext/libevpl submodule).
#   sentinel <patch> <file> <token>
#                               per-(patch,file) marker the apply verifier greps
#                               for in a patched target file, and asserts ABSENT
#                               from the pristine source at authoring time.
#                               <file> is relative to repo-root.

repo-root .
base 8a3db7c7fa30ab27933ddc8b2619412bfc96497b
sentinel 0001-grow-event-loop-arrays.patch src/core/loop_array.h evpl_loop_array_grow
sentinel 0002-poll-refuse-on-exhaustion.patch src/core/poll.c relocate
sentinel 0003-rpc2-conn-lifetime-pin.patch src/rpc2/rpc2.c evpl_rpc2_conn_ref
sentinel 0004-test-loop-array-capacity.patch src/core/tests/loop_array_capacity.c CAPACITY_TEST_N
sentinel 0005-block-open-enxio-on-unavailable-framework.patch src/core/block.c framework-unavailable
