+/* Bytes available from the cursor's current position to the end of the iovec
+ * chain, 64-bit so no 32-bit wire length can wrap it. Returns 0 when the
+ * cursor already sits past the last iovec. */
+static FORCE_INLINE uint64_t
+xdr_read_cursor_remaining(const struct xdr_read_cursor *cursor)
+{
+    xdr_iovec *iov;
+    uint64_t   remaining;
+
+    if (cursor->cur > cursor->last) {
+        return 0;
+    }
+
+    remaining = (uint64_t) xdr_iovec_len(cursor->cur) - cursor->iov_offset;
+
+    for (iov = cursor->cur + 1; iov <= cursor->last; iov++) {
+        remaining += xdr_iovec_len(iov);
+    }
+
+    return remaining;
+} /* xdr_read_cursor_remaining */
+
+/* True when at least `need` bytes remain from the cursor to the end of the
+ * iovec chain.  The common case -- the field fits within the current iovec --
+ * is answered from that one iovec without summing the whole chain; only a field
+ * that spills past the current iovec falls back to xdr_read_cursor_remaining(),
+ * keeping the bound O(1) for every fixed-size primitive in a multi-iovec
+ * decode. */
+static FORCE_INLINE int
+xdr_read_cursor_has_remaining(
+    const struct xdr_read_cursor *cursor,
+    uint64_t                      need)
+{
+    if (cursor->cur <= cursor->last &&
+        need <= (uint64_t) xdr_iovec_len(cursor->cur) - cursor->iov_offset) {
+        return 1;
+    }
+
+    return need <= xdr_read_cursor_remaining(cursor);
+} /* xdr_read_cursor_has_remaining */
