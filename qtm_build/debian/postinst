#!/bin/sh
set -e
mkdir -p /etc/chimera
ln -sf /opt/quantum/chimera/etc/chimera.json /etc/chimera/chimera.json
# Runtime state directory (CHIMERA_STATE_DIR): holds secrets persisted by the
# server (NFS file-handle signing key, SMB server GUID). Shipped in the
# package tree; re-created here for upgrades from packages that lacked it.
mkdir -p /opt/quantum/chimera/share/state
chmod 700 /opt/quantum/chimera/share/state
printf '/opt/quantum/chimera/lib\n' > /etc/ld.so.conf.d/chimera.conf
ldconfig || true
# Systemd
if command -v systemctl >/dev/null 2>&1; then
    systemctl daemon-reload || true
fi
exit 0
