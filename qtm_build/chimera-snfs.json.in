{
    "server": {
	"nfs_enabled": true,
	"smb_enabled": true,
	"s3_enabled": false,
	"delegation_threads": 1,
	"external_portmap": true,
	"max_open_files": 1048576,
	"vfs": {
	    "snfs": {
		"config": "@CMAKE_INSTALL_PREFIX@/etc/chimera/snfs.json",
		"path": "@CMAKE_INSTALL_PREFIX@/lib/libchimera_vfs_snfs.so"
	    }
	}
    },
    "mounts": {
	"snfs1": {
	    "module": "snfs",
	    "path": "/stornext/snfs1"
	}
    },
    "shares": {
        "smb1": {
            "path": "/snfs1/smb1"
        },
        "smb2": {
            "path": "/snfs1/smb2"
        }
    },
    "exports": {
        "/nfs1": {
            "path": "/snfs1/nfs1"
        }
    }
}
