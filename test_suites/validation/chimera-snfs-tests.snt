%sntest chimera-snfs-tests
description Test various SNFS specific feature with chimera

# Example:
# sntest -b master -V PKG_TAG=qtm-master -e vsphere -s chimera-snfs-tests.snt

%include ../include/variables.include
%ifndef PKG_TAG
%error need to provide a QB PKG_TAG
%endif

host srv1	distro:MDC_DISTRO version:MDC_VERSION arch:x86_64 cores:4 memory:8192
host lnx1       distro:LNXCLI_DISTRO version:LNXCLI_VERSION arch:x86_64 cores:2 memory:2048

hostgroup allhosts   srv1 lnx1
hostgroup clients    lnx1


# Define LUNs for MDCs
lun snfs1_meta srv1 8
lun snfs1_data allhosts 32
lun snfs2_meta srv1 8
lun snfs2_data allhosts 32

failstep 10m Capture debug info on failure
command allhosts $sntest/bin/capture_debug_info $spool

step 600 Apply work-around to remove IPv6 localhost from /etc/hosts
command allhosts $sntest/bin/ipv6_hosts_hack

step 10m Preinstall RPM that we might need.
command allhosts $sntest/utilities/tadpole/pre-install-pkg.sh

step 1m extract the NAS sntest_utils
command allhosts curl https://nexus.mdh.quantum.com/repository/snnas-binaries/sn_tests/sntest_utils.tar.gz | tar zxf - -C /

step 10m Make sure that the kernel-devel is installed
command srv1 dnf install -y kernel-devel

step 5m remove MDH path
command srv1 rm -f /etc/profile.d/mdh-env.sh

#  --------------------   install stornext  ---------------
%ifdef HAVE_TSM
%define SNFS_PKG full_suite
%else
%define SNFS_PKG snfs
%endif


step 10m Unpack StorNext
command srv1 $sntest/bin/unpack_stornext SNFS_PKG $sndist /tmp/stornext
command clients $sntest/bin/unpack_stornext client $sndist /tmp/stornext

step 10m Install StorNext
command srv1 $sntest/bin/install_stornext SNFS_PKG /tmp/stornext
command clients $sntest/bin/install_stornext client /tmp/stornext

step 10m Set StorNext Name Servers
command allhosts $sntest/bin/set_fsnameservers $srv1

step 5m Clear temp licenses
command srv1 rm -f /usr/cvfs/config/license.dat

step 600 Start StorNext
command srv1 $sntest/bin/cvfs_control start

step 600 Label LUNs
command srv1 $sntest/bin/label_lun $snfs1_meta CvfsDisk_snfs1_meta
command srv1 $sntest/bin/label_lun $snfs1_data CvfsDisk_snfs1_data
command srv1 $sntest/bin/label_lun $snfs2_meta CvfsDisk_snfs2_meta
command srv1 $sntest/bin/label_lun $snfs2_data CvfsDisk_snfs2_data

step 600 Force Disk Rescan
command srv1 /usr/cvfs/bin/cvadmin -e 'disks refresh'

%ifdef HAVE_TSM
step 600 Configure File System
command srv1 $sntest/bin/configure_fs snfs1 \
   fileLocks=true \
   caseInsensitive=true \
   fileLockResyncTimeOut=20 \
   enforceAcls=true \
   quotas=true \
   namedStreams=true \
   storageManager=true \
   sg0:1:metadata,journal:CvfsDisk_snfs1_meta \
   sg1:1:userdata:CvfsDisk_snfs1_data
%else
command srv1 $sntest/bin/configure_fs snfs1 \
   fileLocks=true \
   caseInsensitive=true \
   fileLockResyncTimeOut=20 \
   enforceAcls=true \
   quotas=true \
   namedStreams=true \
   sg0:1:metadata,journal:CvfsDisk_snfs1_meta \
   sg1:1:userdata:CvfsDisk_snfs1_data
%endif
command srv1 $sntest/bin/configure_fs snfs2 \
   fileLocks=true \
   fileLockResyncTimeOut=20 \
   enforceAcls=true \
   quotas=true \
   sg0:1:metadata,journal:CvfsDisk_snfs2_meta \
   sg1:1:userdata:CvfsDisk_snfs2_data

step 600 Initialize File Systems
command srv1 /usr/cvfs/bin/cvmkfs -F snfs1
command srv1 /usr/cvfs/bin/cvmkfs -F snfs2

step 600 Write FSM list
command srv1 $sntest/bin/append_fsmlist snfs1
command srv1 $sntest/bin/append_fsmlist snfs2

step 600 Configure File System Mounts
command allhosts  $sntest/bin/configure_mount snfs1 /stornext/snfs1 defaults
command allhosts  $sntest/bin/configure_mount snfs2 /stornext/snfs2 defaults

step 5m Restart StorNext on MDC
command srv1 $sntest/bin/cvfs_control restart

step 5m Restart StorNext on clients
command clients $sntest/bin/cvfs_control restart

%ifdef HAVE_TSM
# --------------------- Configure the SDISK and Storage destination --------------
step 600 Create relation and sdisk directories
command srv1 mkdir /stornext/snfs1/managed
command srv1 mkdir /stornext/snfs2/sdisk1

step 600 check TSM
command srv1 $sntest/bin/profile tsmup

step 600 Configure sdisk
command srv1 $sntest/bin/profile fsdiskcfg -a -p /stornext/snfs2/sdisk1 -c 1 -s 4 Storage_Disk_1

step 600 Configure backup for Managed filesystem
command srv1 $sntest/bin/configure_snbackup snfs1 /stornext/snfs1 sdisk

step 600 Add policy class for creating a managed filesystem in TSM.
command srv1 $sntest/bin/profile fsaddclass policyclass -d 1 -m 1 -t sdisk

step 600 Add relation point to (policyclass)
command srv1 $sntest/bin/profile fsaddrelation /stornext/snfs1/managed -c policyclass
%endif

#  --------------------   install Chimera  ---------------
step 3m stop NFS services
command srv1 systemctl stop rpc-statd && systemctl stop autofs


step 2m Download chimera pkg for Stornext
command srv1 /sntest_utils/get_qb_asset.py -p chimera -t PKG_TAG -d /chimera-repo -u release/Rocky9/amd64/repo-chimera.tar.gz

step 2m install the chimera PKG
command srv1 dnf install -y /chimera-repo/*.rpm

step 1m Create base chimera.json file
command srv1 sed -i.back 's/\/chimera.json/\/sntest-chimera.json/'  /etc/default/chimera && \
	     cat /etc/default/chimera && \
	     jq -n '{ \
                 server: { \
                    threads: 16, \
                    external_portmap: true, \
                    max_open_files: 1048576, \
                    rest_http_port: 8080, \
		    vfs: { \
		       "snfs": { \
		          "path": "/opt/quantum/chimera/lib/libchimera_vfs_snfs.so" \
		       } \
		    } \
                 }, \
		 users: [ \
		    { username: "testuser1", smbpasswd: "systest", uid: 5000, gid: 50} \
                 ], \
                 mounts: { \
                    snfs1: { \
                       path: "/stornext/snfs1", \
                       module: "snfs" \
                    } \
                }, \
                shares: { \
                   smb1: { path: "/snfs1" } \
                }, \
                exports: { \
                   "/nfs1": { path: "/snfs1" } \
                } }'  > /etc/chimera/sntest-chimera.json

step 5m enable and start chimera
command srv1 cat /etc/default/chimera
command srv1 jq . /etc/chimera/sntest-chimera.json
command srv1 systemctl enable chimera && \
	     systemctl start chimera && \
	     sleep 5 && \
	     systemctl status chimera

step 5m check chimera config
command srv1 curl -s "http://127.0.0.1:8080/api/v1/users" | jq
command srv1 curl -s "http://127.0.0.1:8080/api/v1/shares" | jq
command srv1 curl -s "http://127.0.0.1:8080/api/v1/exports" | jq

# ----------------- Setup linux client -----------------
%define SMBCLIENT smbclient -U WORKGROUP/testuser1%systest //$srv1/smb1

step 5m Linux Prepare clients
command lnx1 /bin/echo -e "username=testuser1\npassword=systest\ndomain=WORKGROUP" > /root/.smb_cred

step 5m install smbclient
command lnx1 apt update && apt install -y smbclient cifs-utils

step 1m validate that we have access.
command lnx1 SMBCLIENT -c 'ls'

step 5m Connect to smb1 share
command lnx1 mkdir -p /smb1 && mount.cifs -ocredentials=/root/.smb_cred //$srv1/smb1 /smb1

# ----------------- get test suites -----------------
step 5m get elbencho
command lnx1 curl https://repository.mdh.quantum.com/repository/tests/elbencho/elbencho-static-x86_64.tar.gz | \
	tar zxf - -C /usr/bin

# Connectathon testing
step 5m lnx1 Get connectathon
command lnx1 curl https://repository.mdh.quantum.com/repository/cthon/cthon04.tar.gz | \
	tar zxf - -C /root/

step 5m create nfstest user
command lnx1 mkdir -p /home1 -m 0755 && useradd -m nfstest -b /home1 && \
	     echo "nfstest ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers.d/nfstest

# Download NFStest-9408954 pkg
step 5m lnx1 Get NFStest-9408954
command lnx1 curl https://repository.mdh.quantum.com:8443/repository/nfs_protocol_test/git/NFStest-9408954.tar.gz | \
	tar zxf - -C /home1/nfstest

# ----------------- Run test -----------------


# ===== Test general metdata operation ===========

# TODO: create the Directory on Stornext have have SMB see it.
step 1m create test directory
command lnx1 mkdir -p /smb1/lnx

step 10m run MDT over smb1
command lnx1 /usr/cvfs/bin/mdt  -m -s -f 1000 -n 4 -U /smb1/lnx && rm -rf /smb1/lnx

step 2m rename test over SMB
command lnx1  mkdir /smb1/rename-test && cd /smb1/rename-test && mkdir -p dir1 dir2 && \
	      touch file1 dir1/file1 dir1/file2 dir1/file3 && \
	      mv file1 dir1 && mv dir1/file1 dir2/rename1 && \
	      cd dir1 && mv file2 ../rename2 && mv file3 /smb1/rename-test/dir2 && cd .. && \
	      stat dir2/rename1 rename2 dir2/file3

step 10m run elbencho over SMB
command lnx1 mkdir -p /smb1/lnx1-smb1 && \
	/usr/bin/elbencho /smb1/lnx1-smb1 --size=1m --dirs=4 --files=10 --mkdirs --write && \
	/usr/bin/elbencho /smb1/lnx1-smb1 --size=1m --dirs=4 --files=10 --deldirs --delfiles --read

%ifndef NO_NFSv3
step 5m Mount the NFSv3 share
command lnx1 mkdir -p /nfs1 && mount -v -o vers=3 $srv1:/nfs1 /nfs1

step 2m	basic tests over NFSv3
command lnx1 dd if=/dev/zero count=3 of=/nfs1/file1 && stat /nfs1/file1 && mv /nfs1/file1 /nfs1/file1.moved
command lnx1 touch /nfs1/chmod_file && chmod 600 /nfs1/chmod_file && stat -c '%a' /nfs1/chmod_file | grep 600

step 10m run elbencho over NFSv3
command lnx1 mkdir -p /nfs1/lnx1-nfsv3 && \
	/usr/bin/elbencho /nfs1/lnx1-nfsv3 --size=1m --dirs=4 --files=10 --mkdirs --write && \
	/usr/bin/elbencho /nfs1/lnx1-nfsv3 --size=1m --dirs=4 --files=10 --deldirs --delfiles --read

# Connectathon testing
step 5m lnx1 Get connectathon
command lnx1 curl https://repository.mdh.quantum.com/repository/cthon/cthon04.tar.gz | \
	tar zxf - -C /root/

step 10M Run Connectathon basic test
command lnx1 cd /root/cthon04/cthon04/basic && \
	     NFSTESTDIR=/nfs1/cthon_basic ./runtests

step 10M Run Connectathon special test
command lnx1 cd /root/cthon04/cthon04/special && \
	     NFSTESTDIR=/nfs1/cthon_special ./runtests

step 5m Umount the NFSv3 directory
command lnx1 umount /nfs1

step 10M Run NFStest-9408954 nfstest_posix
command lnx1 cd /home1/nfstest/NFStest-9408954 && \
	     sudo -u nfstest -E bash -c 'PYTHONPATH=./ ./test/nfstest_posix  --nfsversion=3 -s $srv1 -e /nfs1'
%endif

# ----------------- Setup/Run NFSv4 test -----------------
%ifndef NO_NFSv4
step 5m Mount the NFSv4 share
command lnx1 mkdir -p /nfs1 && mount -v -o vers=4 $srv1:/nfs1 /nfs1

step 2m	basic tests over NFSv4
command lnx1 dd if=/dev/zero count=3 of=/nfs1/file2 && stat /nfs1/file2 && mv /nfs1/file2 /nfs1/file2.moved
command lnx1 touch /nfs1/chmod_file2 && chmod 600 /nfs1/chmod_file2 && stat -c '%a' /nfs1/chmod_file2 | grep 600

step 10m run elbencho over NFSv4
command lnx1 mkdir -p /nfs1/lnx1-nfsv4 && \
	/usr/bin/elbencho /nfs1/lnx1-nfsv4 --size=1m --dirs=4 --files=10 --mkdirs --write && \
	/usr/bin/elbencho /nfs1/lnx1-nfsv4 --size=1m --dirs=4 --files=10 --deldirs --delfiles --read

step 10M Run Connectathon basic test
command lnx1 cd /root/cthon04/cthon04/basic && \
	     NFSTESTDIR=/nfs1/cthon_basic ./runtests

step 10M Run Connectathon special test
command lnx1 cd /root/cthon04/cthon04/special && \
	     NFSTESTDIR=/nfs1/cthon_special ./runtests

step 5m Umount the NFSv4 directory
command lnx1 umount /nfs1

step 10M Run NFStest-9408954 nfstest_posix
command lnx1 cd /home1/nfstest/NFStest-9408954 && \
	     sudo -u nfstest -E bash -c 'PYTHONPATH=./ ./test/nfstest_posix -s $srv1 -e /nfs1'
%endif

%ifndef SKIP_FAIL
# ================ Test create time ==============
# vfs_snfs (CvApi_SetNtCreateTime)

step 1m create test file
command srv1 touch /stornext/snfs1/test_crtime

step 5m get the file create time
command srv1 sleep 30; echo show inode smb1/test_crtime | /usr/cvfs/bin/cvfsdb snfs1 | grep idi_crttime.tv_sec
command lnx1 SMBCLIENT -c 'allinfo test_crtime' | grep create_time

step 1m change time to Jan 1 1990 with Linux client.
command lnx1 SMBCLIENT  -c 'utimes test_crtime 90:01:01-00:00:00 -1 -1 -1'

step 1m Confirm create time is 1990
command srv1 sleep 30; echo show inode smb1/test_crtime | /usr/cvfs/bin/cvfsdb snfs1 | grep idi_crttime.tv_sec | grep 1990
command lnx1 SMBCLIENT -c 'allinfo test_crtime' | grep create_time | grep 1990

%endif






