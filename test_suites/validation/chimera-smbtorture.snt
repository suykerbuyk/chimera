%sntest chimera-smbtorture
description Run smbtorture tests against the Chimera NAS server

# Example:
# sntest -b master -V PKG_TAG=develop -e vsphere -s chimera-smbtorture.snt

%include ../include/variables.include
%ifndef PKG_TAG
%error need to provide a QB PKG_TAG
%endif

%if OS_DISTRO != ubuntu-server
%error Test only support ubuntu-server server
%endif

host srv1	distro:OS_DISTRO version:OS_VERSION arch:x86_64 cores:2 memory:8192

hostgroup allhosts   srv1

# share FS
lun share_fs srv1 100

failstep 10m Capture debug info on failure
command allhosts $sntest/bin/capture_debug_info $spool
command srv1 journalctl -u chimera -o short-iso | sed 's/ snt.*message="/ /' | tee $spool/chimera_log.txt
command srv1 dmesg | tail -100

step 1m extract the NAS sntest_utils
command allhosts curl https://nexus.mdh.quantum.com/repository/snnas-binaries/sn_tests/sntest_utils.tar.gz | tar zxf - -C /


step 5m install extra pkg
command allhosts apt update && apt install -y smbclient cifs-utils jq



#  --------------------   install Chimera  ---------------
step 5m setup ntlm authentication.
command srv1 mkdir -p /etc/chimera && \
	echo "WORKGROUP:testuser1:systest" >/etc/chimera/ntlm.txt && \
	echo "export NTLM_USER_FILE=/etc/chimera/ntlm.txt" > /etc/profile.d/chimera.sh

%if OS_VERSION == 24.04
step 2m Download chimera pkg for Ubuntu24
command srv1 /sntest_utils/get_qb_asset.py -p chimera -t PKG_TAG -d /chimera-repo -u release/Ubuntu24/amd64/repo-chimera.tar.gz
%else
step 2m Download chimera pkg for Ubuntu22
command srv1 /sntest_utils/get_qb_asset.py -p chimera -t PKG_TAG -d /chimera-repo -u release/Ubuntu22/amd64/repo-chimera.tar.gz
%endif

step 2m install the chimera PKG
command srv1 apt install -y /chimera-repo/*.deb

step 5m setup share filesystem
command srv1 echo $share_fs && \
	parted /dev/sda mklabel gpt && \
	parted /dev/sda mkpart "" ext4 0% 100% && \
	sleep 5 && mkfs.ext4  /dev/sda1 && \
	mkdir /shares && \
	mount /dev/sda1 /shares && \
	chmod 777 /shares && \
	mkdir -m 777 -p /shares/nfs1 /shares/smb1

step 1m update chimera.json file
command srv1 cd /etc/chimera && \
	cp chimera.json chimera.json.bak && \
	jq '.server.external_portmap = true | \
	   .mounts.linux_dir.path = "/shares" | \
	   .shares.smb1.path = "/linux_dir/smb1" \
	   ' chimera.json > chimera.json.tmp && \
	mv chimera.json.tmp /opt/quantum/chimera/etc/chimera.json


step 5m start chimera
command srv1 systemctl start chimera.service && \
	sleep 5 && \
	systemctl status chimera.service

# ----------------- Setup linux client -----------------
step 5m install smbclient and smbtorture
command srv1 apt install -y smbclient samba-testsuite

step 5m Setup Samba config on the client
command srv1 net conf setparm global workgroup WORKGROUP
command srv1 net conf setparm global torture:samba3 yes
command srv1 net conf setparm global torture:localdir /share
command srv1 net conf setparm global torture:filename testfile
command srv1 net conf setparm global torture:offset 1
command srv1 net conf setparm global torture:beyond_final_zero 131072

step 1m generate config for smbtorture
command srv1 net conf list > /etc/samba/smb.conf

step 1m validate SMB config
command srv1 testparm -s 2>/dev/null
command srv1 net conf list

step 1m validate that we have access.
command srv1 smbclient -U testuser1%systest //$srv1/smb1 -c 'ls'

# ----------------- Run test -----------------
step 5m Gather test groups lists
command allhosts smbtorture  --list-suites | grep '^smb2' | sort | tee /tmp/smb2-suite-all

step 5m Create test smb2 group list
command srv1 echo -e "\
smb2.read\n\
smb2.compound_find\n\
smb2.sharemode\n\
smb2.delete-on-close-perms\n\
smb2.deny\n\
smb2.openattr\n\
smb2.winattr\n\
smb2.sdread\n\
smb2.secleak\n\
smb2.session-id\n\
smb2.connect\n\
smb2.bench-oplock\n\
smb2.fileid\n\
smb2.rename\n\
smb2.rw\n\
smb2.acls\n\
smb2.check-sharemode" | sort | tee /tmp/smb2-suite


step 1m Compare the list
command srv1  diff /tmp/smb2-suite /tmp/smb2-suite-all ; true

step 5m smb2 test group
command srv1 $sntest/utilities/tadpole/run_torture.sh WORKGROUP/testuser1%systest \
	//$srv1/smb1 /tmp/smb2-suite -t 600 -r /tmp/result-smb2  2>/tmp/smb2-suite.stderr


step 1m Make sure all the test passed
command srv1 ! grep "FAILED" /tmp/result-smb2
