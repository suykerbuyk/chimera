# Variables:
#
#  * MDC_DISTRO:  rockyl(default)
#    - Specific distribution to use
#    - Optional.
#
#  * MDC_VERSION: 9.5(default)
#    - Specific OS release to utilize.
#    - Optional.
#
#  * OS_DISTRO:  ubuntu-server(default)
#    - Specific distribution to use
#    - Optional.
#
#  * OS_VERSION: 24.04(default)
#    - Specific OS release to utilize.
#    - Optional.
#
#  * LNXCLI_DISTRO: ubuntu-server(default)
#    - Specific distribution used by NAS clients
#    - Optional.
#
#  * LNXCLI_VERSION: 24.04(default)
#    - Specific OS release to utilize by NAS Client
#    - default OS_VERSION
#    - Optional.
#

%ifndef MDC_DISTRO
%define MDC_DISTRO rockyl
%endif

%ifndef MDC_VERSION
%define MDC_VERSION 9.5
%endif

%ifndef OS_DISTRO
%define OS_DISTRO ubuntu-server
%endif

%ifndef OS_VERSION
%define OS_VERSION 24.04
%endif

%ifndef LNXCLI_DISTRO
%define LNXCLI_DISTRO ubuntu-server
%endif

%ifndef LNXCLI_VERSION
%define LNXCLI_VERSION 24.04
%endif


