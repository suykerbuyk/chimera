# Variables:
#
# AUTH Section
#
# AUTH_ADS = 1: (Default ADS auth to SNNAS-LAB)
#   AD_DOMAIN    - AD domain to join                   (default: snnas-lab.mdh.quantum.com)
#   AD_USER      - AD account used to join the domain  (default: nasadmin)
#   AD_PASS      - password of the join account        (default: nasadmin)
#   AD_REALM     - kerberos realm of the domain        (default: SNNAS-LAB.MDH.QUANTUM.COM)
#   AD_WORKGROUP - short/NetBIOS domain name           (default: SNNAS-LAB)
#
#  * MDC_DISTRO:  rockyl(default)
#    - Specific distribution to use
#    - Optional.
#
#  * MDC_VERSION: 9.5(default)
#    - Specific OS release to utilize.
#    - Optional.
#
#  * CHIM_OS:  24(default)
#    - specify what version for Chimera Server
#    -  9 == Rocky 9
#    - 22 == Ubuntu 22.04
#    - 24 == Ubuntu 24.04.3
#    - 26 == Ubuntu 26.04
#    - Optional.
#
#  * OS_DISTRO:  ubuntu-server(default)
#    - Specific distribution to use
#    - Optional.
#
#  * OS_VERSION: 24.04.3(default)
#    - Specific OS release to utilize.
#    - Optional.
#
#  * LNXCLI_DISTRO: ubuntu-server(default)
#    - Specific distribution used by NAS clients
#    - Optional.
#
#  * LNXCLI_VERSION: 24.04.3(default)
#    - Specific OS release to utilize by NAS Client
#    - default OS_VERSION
#    - Optional.
#

%ifndef AD_AUTH
%define AD_AUTH 1
%endif

%if AD_AUTH == 1
%define AD_DOMAIN snnas-lab.mdh.quantum.com
%define AD_USER nasadmin
%define AD_PASS nasadmin
%define AD_REALM SNNAS-LAB.MDH.QUANTUM.COM
%define AD_WORKGROUP SNNAS-LAB
%endif

%if AD_AUTH == 2
%define AD_DOMAIN mdh.quantum.com
%define AD_USER nasadmin
%define AD_PASS nasadmin
%define AD_REALM MDH.QUANTUM.COM
%define AD_WORKGROUP MDH
%endif

%ifndef MDC_DISTRO
%define MDC_DISTRO rockyl
%endif

%ifndef MDC_VERSION
%define MDC_VERSION 9.5
%endif

%ifndef LNXCLI_DISTRO
%define LNXCLI_DISTRO ubuntu-server
%endif

%ifndef LNXCLI_VERSION
%define LNXCLI_VERSION 26.04
%endif


%ifndef CHIM_OS
%define CHIM_OS 26
%endif

# Ubuntu 26
%if CHIM_OS == 26
%define QB_OS Ubuntu26

%ifndef OS_DISTRO
%define OS_DISTRO ubuntu-server
%endif

%ifndef OS_VERSION
%define OS_VERSION 26.04
%endif

# endif CHIM_OS == 26
%endif

# Ubuntu 24
%if CHIM_OS == 24
%define QB_OS Ubuntu24

%ifndef OS_DISTRO
%define OS_DISTRO ubuntu-server
%endif

%ifndef OS_VERSION
%define OS_VERSION 24.04.3
%endif

# endif CHIM_OS == 24
%endif

# Ubuntu 22
%if CHIM_OS == 22
%define QB_OS Ubuntu22

%ifndef OS_DISTRO
%define OS_DISTRO ubuntu-server
%endif

%ifndef OS_VERSION
%define OS_VERSION 22.04.1
%endif

# endif CHIM_OS == 22
%endif


# Rocky9
%if CHIM_OS == 9
%define QB_OS Rock9

%ifndef OS_DISTRO
%define OS_DISTRO rockyl
%endif

%ifndef OS_VERSION
%define OS_VERSION 9.5
%endif

# endif CHIM_OS == 9
%endif





