# Variables:
#
#  * OS_DISTRO: rockyl(default)
#    - Specific distribution to use
#    - Optional.
#
#  * OS_VERSION: 9.5(default)
#    - Specific OS release to utilize.
#    - Optional.
#
#  * LNXCLI_DISTRO: rockyl(default)
#    - Specific distribution used by NAS clients
#    - Optional.
#
#  * LNXCLI_VERSION: 9.5(default)
#    - Specific OS release to utilize by NAS Client
#    - default OS_VERSION
#    - Optional.
#

%ifndef OS_VERSION
%define OS_VERSION 9.5
%endif

%ifndef OS_DISTRO
%define OS_DISTRO rockyl
%endif

%ifndef LNXCLI_VERSION
%define LNXCLI_VERSION 9.5
%endif

%ifndef LNXCLI_DISTRO
%define LNXCLI_DISTRO rockyl
%endif


